generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────

enum Rol {
  ADMIN
  FAMILIAR
  CONSULTA
}

enum TipoCultivo {
  CAFE
  CANA_AZUCAR
}

enum EstadoCultivo {
  ACTIVO
  COSECHADO
  PERDIDO
}

enum ActividadBitacora {
  FERTILIZACION
  FUMIGACION
  PODA
  DESHIERBE
  COSECHA
  SIEMBRA
  MANTENIMIENTO
  OTRO
}

enum CategoriaGasto {
  INSUMOS
  MANO_DE_OBRA
  MANTENIMIENTO
  TRANSPORTE
  ADMINISTRACION
  OTRO
}

enum EstadoVenta {
  PENDIENTE
  COMPLETADA
  ANULADA
}

// ─── Models ──────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(FAMILIAR)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fincas        Finca[]
  refreshTokens RefreshToken[]
  movimientos   MovimientoInventario[]
  ventas        Venta[]
  gastos        Gasto[]
  bitacoras     Bitacora[]

  @@map("usuarios")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Finca {
  id          Int      @id @default(autoincrement())
  nombre      String
  ubicacion   String?
  hectareas   Float?
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId  Int
  user    User  @relation(fields: [userId], references: [id])
  lotes   Lote[]
  gastos  Gasto[]

  @@map("fincas")
}

model Lote {
  id          Int      @id @default(autoincrement())
  nombre      String
  area        Float?
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fincaId   Int
  finca     Finca      @relation(fields: [fincaId], references: [id])
  cultivos  Cultivo[]
  bitacoras Bitacora[]
  jornales  Jornal[]
  gastos    Gasto[]

  @@map("lotes")
}

model Cultivo {
  id                   Int            @id @default(autoincrement())
  tipo                 TipoCultivo
  nombre               String
  variedad             String?
  fechaSiembra         DateTime
  fechaCosechaEstimada DateTime?
  fechaCosechaReal     DateTime?
  estado               EstadoCultivo  @default(ACTIVO)
  cantidadSembrada     Float?
  numeroSoca           Int?
  edadCafetal          Int?
  plantasPorHectarea   Float?
  rendimientoEstimado  Float?
  activo               Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  loteId    Int
  lote      Lote        @relation(fields: [loteId], references: [id])
  gastos    Gasto[]
  bitacoras Bitacora[]

  @@map("cultivos")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  telefono  String?
  email     String?
  direccion String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ventas Venta[]

  @@map("clientes")
}

model Proveedor {
  id        Int      @id @default(autoincrement())
  nombre    String
  telefono  String?
  email     String?
  direccion String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gastos Gasto[]

  @@map("proveedores")
}

model Producto {
  id             Int      @id @default(autoincrement())
  nombre         String
  descripcion    String?
  categoria      String?
  unidadMedida   String   @default("unidad")
  stockActual    Float    @default(0)
  stockMinimo    Float    @default(0)
  precioUnitario Float?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movimientos   MovimientoInventario[]
  detalleVentas DetalleVenta[]
  bitacoras     Bitacora[]

  @@map("productos")
}

model MovimientoInventario {
  id        Int      @id @default(autoincrement())
  tipo      String
  cantidad  Float
  motivo    String?
  fecha     DateTime @default(now())
  createdAt DateTime @default(now())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  @@index([productoId, fecha])
  @@map("movimientos_inventario")
}

model Venta {
  id        Int         @id @default(autoincrement())
  fecha     DateTime    @default(now())
  total     Float
  estado    EstadoVenta @default(PENDIENTE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  clienteId Int
  cliente   Cliente       @relation(fields: [clienteId], references: [id])
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  detalles  DetalleVenta[]

  @@index([userId, fecha])
  @@map("ventas")
}

model DetalleVenta {
  id             Int   @id @default(autoincrement())
  cantidad       Float
  precioUnitario Float
  subtotal       Float

  ventaId    Int
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  @@map("detalles_venta")
}

model Gasto {
  id          Int             @id @default(autoincrement())
  descripcion String
  monto       Float
  categoria   CategoriaGasto?
  fecha       DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  proveedorId Int?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  cultivoId   Int?
  cultivo     Cultivo?   @relation(fields: [cultivoId], references: [id])
  fincaId     Int?
  finca       Finca?     @relation(fields: [fincaId], references: [id])
  loteId      Int?
  lote        Lote?      @relation(fields: [loteId], references: [id])
  userId      Int
  user        User       @relation(fields: [userId], references: [id])

  @@index([userId, fecha])
  @@index([fincaId])
  @@index([loteId])
  @@map("gastos")
}

model Trabajador {
  id          Int      @id @default(autoincrement())
  nombre      String
  telefono    String?
  direccion   String?
  tipo        String   @default("temporal")
  salarioBase Float?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jornales Jornal[]

  @@map("trabajadores")
}

model Jornal {
  id          Int      @id @default(autoincrement())
  fecha       DateTime
  horas       Float?
  tarea       String?
  montoPagado Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trabajadorId Int
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])
  loteId       Int
  lote         Lote       @relation(fields: [loteId], references: [id])

  @@index([loteId, fecha])
  @@index([trabajadorId])
  @@map("jornales")
}

model Bitacora {
  id            Int                @id @default(autoincrement())
  fecha         DateTime           @default(now())
  actividad     ActividadBitacora
  descripcion   String
  cantidad      Float?
  unidadMedida  String?
  costo         Float              @default(0)
  observaciones String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  loteId     Int
  lote       Lote       @relation(fields: [loteId], references: [id])
  cultivoId  Int?
  cultivo    Cultivo?   @relation(fields: [cultivoId], references: [id])
  productoId Int?
  producto   Producto?  @relation(fields: [productoId], references: [id])
  userId     Int
  user       User       @relation(fields: [userId], references: [id])

  @@index([loteId, fecha])
  @@index([cultivoId])
  @@index([fecha])
  @@map("bitacoras")
}
